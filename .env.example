# Documentation only: this file is NOT loaded automatically.
# Replace placeholders and inject environment before migration/service startup.
APP_ENV=development
CREDIT_RISK_PROJECT_ROOT=.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/creditrisk
CREDIT_RISK_API_KEY=benim-uzun-local-api-keyim-123456789
CREDIT_RISK_API_KEY_ID=local-dev
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=65536
# The API key placeholder is deliberately rejected at startup.
# Use a randomly generated secret of at least 32 characters; never commit it.
# No CORS allowlist is configured: cross-origin browser access is disabled.

# Docker Compose only: copy this file to an ignored .env and replace placeholders.
# Use URL-safe random hex secrets for POSTGRES_PASSWORD (embedded in DATABASE_URL).
POSTGRES_DB=creditrisk
POSTGRES_USER=creditrisk
POSTGRES_PASSWORD=BenimGucluLocalSifrem123
API_PORT=8000
# Compose derives DATABASE_URL with host db; the host URL above is for non-container use.
